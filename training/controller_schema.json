{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uruk.local/schemas/controller-example-v1.json",
  "title": "URUK Controller Training Example",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "example_id", "split", "source", "input", "output"],
  "properties": {
    "schema_version": {
      "const": "uruk_controller_example.v1"
    },
    "example_id": {
      "type": "string",
      "pattern": "^ctrl_[a-f0-9]{16}$"
    },
    "split": {
      "enum": ["train", "validation", "test"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "approved_for_training"],
      "properties": {
        "kind": {
          "enum": ["seed", "contrast_set", "coordinate_benchmark", "stability_golden", "approved_episode", "approved_shadow", "approved_factory"]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "approved_for_training": {
          "const": true
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_input", "runtime_signals"],
      "properties": {
        "user_input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "runtime_signals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "text_length",
            "pipeline_mode",
            "selected_modes",
            "available_capabilities",
            "protocol_concept_detected",
            "coordinate_card_ids",
            "kairos_memory_match",
            "fresh_external_evidence_required",
            "forced_mode_requested",
            "estimated_context_tokens",
            "estimated_model_calls"
          ],
          "properties": {
            "schema_version": {"const": "uruk_controller_signals.v1"},
            "text_length": {"type": "integer", "minimum": 0, "maximum": 100000},
            "pipeline_mode": {"type": "string", "minLength": 1, "maxLength": 64},
            "selected_modes": {
              "type": "array",
              "items": {"type": "string", "maxLength": 64},
              "maxItems": 16,
              "uniqueItems": true
            },
            "available_capabilities": {
              "type": "array",
              "items": {"type": "string", "maxLength": 64},
              "maxItems": 64,
              "uniqueItems": true
            },
            "protocol_concept_detected": {"type": "boolean"},
            "coordinate_card_ids": {
              "type": "array",
              "items": {"type": "string", "maxLength": 128},
              "maxItems": 16,
              "uniqueItems": true
            },
            "kairos_memory_match": {"type": "boolean"},
            "fresh_external_evidence_required": {"type": "boolean"},
            "forced_mode_requested": {"type": "boolean"},
            "estimated_context_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "estimated_model_calls": {"type": "integer", "minimum": 0, "maximum": 64}
          }
        }
      }
    },
    "output": {
      "$ref": "#/$defs/controllerDecision"
    }
  },
  "$defs": {
    "controllerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "route_kind",
        "pipeline",
        "knowledge_layers",
        "task_profile",
        "model_budget",
        "tool_permission",
        "escalation_required",
        "confidence",
        "reason_codes"
      ],
      "properties": {
        "schema_version": {"const": "uruk_controller_decision.v1"},
        "route_kind": {
          "enum": [
            "deterministic_memory",
            "world_query",
            "self_upgrade",
            "code_task",
            "deep_reasoning",
            "tool_task",
            "small_task",
            "forced"
          ]
        },
        "pipeline": {"type": "string", "minLength": 1, "maxLength": 64},
        "knowledge_layers": {
          "type": "array",
          "items": {
            "enum": ["kairos", "theory", "protocol", "runtime", "harness", "external_current"]
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "task_profile": {
          "enum": [
            "deterministic",
            "auto",
            "local_language",
            "deep_reasoning",
            "code_coworker",
            "upgrade",
            "api_reasoning",
            "windows_copilot"
          ]
        },
        "model_budget": {"type": "integer", "minimum": 0, "maximum": 12},
        "tool_permission": {
          "enum": [
            "none",
            "read_only",
            "search_read",
            "workspace_write_reviewed",
            "system_change_reviewed",
            "operator_confirmed_hardware"
          ]
        },
        "escalation_required": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason_codes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9_.-]{1,96}$"},
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        }
      }
    }
  }
}
