# URUK Trinity Console — API keys
# 將呢個檔案複製做 .env，填寫實際 API key
# .env 已經喺 .gitignore，唔會上 git

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
XAI_API_KEY=xai-...

# 如果用 OpenRouter（單一 key 訪問所有 provider）：
OPENROUTER_API_KEY=sk-or-...

# Free direct APIs (cross-family 三聲座標):
GROQ_API_KEY=gsk-...
GEMINI_API_KEY=AIza...
CEREBRAS_API_KEY=csk-...

# v8.3 free-tier additions — apply for keys at each provider's console:
# NVIDIA NIM (1000 credits permanent, 40 RPM, 100+ models incl. DeepSeek-R1, Kimi-K2.5, GLM-5)
#   https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=nvapi-...

# SambaNova Cloud (Llama 3.1 405B, DeepSeek R1, 10-30 RPM, 20M tokens/day)
#   https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=...

# Cloudflare Workers AI (10K Neurons/day permanent free, OpenAI-compat gateway)
#   https://dash.cloudflare.com/ → Workers & Pages → AI
CLOUDFLARE_AI_KEY=...
CLOUDFLARE_ACCOUNT_ID=...   # ← substituted into api_base URL at call time

# Chutes AI (Bittensor-subsidized free tier)
#   https://chutes.ai/
CHUTES_API_KEY=cpk_...

# Hyperbolic (Qwen3 480B Coder, gpt-oss-120B, DeepSeek V3/R1, 60 RPM)
#   https://app.hyperbolic.xyz/
HYPERBOLIC_API_KEY=...

# Pollinations (anonymous; per-IP rate; no key needed)
#   https://pollinations.ai/

# Ollama 唔需要 API key（本地運行）
